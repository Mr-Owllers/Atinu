        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        link(rel="icon", type="image/x-icon", href="static/favicon.ico")
        link(rel="stylesheet", href="css/style.css")
        block title
            title default title
    body 
        .nav
            a(href="/" title="Home") <i class="nf nf-fa-home"></i>
            a(href="dic" title="Dictionary") <i class="nf nf-fa-book"></i>
            a(href="grm" title="Grammar") <i class="nf nf-fa-pencil"></i>
            a(href="res" title="Resources") <i class="nf nf-fa-folder"></i>
            a(href="con" title="Contact") <i class="nf nf-fa-comment"></i>
            
        block body
